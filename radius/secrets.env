# Canonical list of lab secrets. This file is the human-readable source of
# truth, but Cisco IOS and FreeRADIUS cannot read docker env files directly,
# so the same values are repeated in:
#   radius/clients.conf
#   radius/users
#   configs/SW1.cfg, SW2.cfg, SW3.cfg   (RADIUS key + enable secret)
#   configs/R1.cfg, R2.cfg              (enable secret)
#   endpoints/client/wpa_supplicant-*.conf
# tests/verify_configs.py checks that these copies stay in sync.
#
# CHANGE THIS VALUE in all of the files above before using the lab outside
# an isolated GNS3 project.
RADIUS_SECRET=S3cr3t-Shared-Key-2026
DEVICE_ENABLE_SECRET=En4ble-Secret-2026

# Endpoint credentials used by the users file and wpa_supplicant configs.
STAFF1_PASSWORD=Staff1Pass!
STAFF2_PASSWORD=Staff2Pass!
STAFF3_PASSWORD=Staff3Pass!
STUDENT1_PASSWORD=Student1Pass!
STUDENT2_PASSWORD=Student2Pass!
STUDENT3_PASSWORD=Student3Pass!
GUEST1_PASSWORD=Guest1Pass!

# Fixed MAC addresses for the three sensors. Set these on the GNS3 Docker
# nodes (or via SENSOR_MAC) so MAB matches radius/users entry-for-entry.
SENSOR_MAC_TEMP=0200.0000.4001
SENSOR_MAC_MOTION=0200.0000.4002
SENSOR_MAC_HUMIDITY=0200.0000.4003

# Server segment (also used by the sensor container defaults).
RADIUS_IP=192.168.50.10
MQTT_IP=192.168.50.20
MQTT_PORT=1883
