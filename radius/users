# ---------------------------------------------------------------------------
# IOT sensors -> VLAN 40 (MAB)
# MACs match radius/secrets.env SENSOR_MAC_* and the GNS3 Docker node MACs.
# ---------------------------------------------------------------------------
0200.0000.4001  Cleartext-Password := "0200.0000.4001"
                Tunnel-Type = VLAN,
                Tunnel-Medium-Type = IEEE-802,
                Tunnel-Private-Group-Id = "40"

0200.0000.4002  Cleartext-Password := "0200.0000.4002"
                Tunnel-Type = VLAN,
                Tunnel-Medium-Type = IEEE-802,
                Tunnel-Private-Group-Id = "40"

0200.0000.4003  Cleartext-Password := "0200.0000.4003"
                Tunnel-Type = VLAN,
                Tunnel-Medium-Type = IEEE-802,
                Tunnel-Private-Group-Id = "40"

